cabal-version:      2.2
name:               agent-claude
version:            0.1.0.0
synopsis:           Claude Code subscription adapter for Agent.Loop
description:        Subscription authentication and Agent.Loop translation
                    built on claude-agent-sdk-haskell.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple
extra-source-files: README.md

common common-opts
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , RecordWildCards
                      , NamedFieldPuns
                      , NumericUnderscores
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wno-unused-do-bind
                      -Wno-name-shadowing
                      -Wno-missing-signatures

library
    import:           common-opts
    hs-source-dirs:   src
    exposed-modules:  Agent.Claude
                    , Agent.Claude.Auth
                    , Agent.Claude.LoopBackend
                    , Agent.Claude.Options
    other-modules:    Agent.Claude.Internal.Environment
                    , Agent.Claude.Internal.Messages
    build-depends:    base                  >= 4.14 && < 5
                    , agent-core            >= 0.1 && < 0.2
                    , agent-responses       >= 0.1 && < 0.2
                    , agent-responses-types >= 0.1 && < 0.2
                    , claude-agent-sdk-haskell >= 0.1 && < 0.2
                    , aeson                 >= 2.0
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process               >= 1.6.26
                    , safe-exceptions
                    , text
                    , uuid-types

test-suite agent-claude-test
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.Claude.AuthSpec
                    , Agent.Claude.LoopBackendSpec
    ghc-options:      -threaded
    build-depends:    base >= 4.14 && < 5
                    , agent-claude
                    , agent-core
                    , agent-responses
                    , agent-responses-types
                    , claude-agent-sdk-haskell
                    , bytestring
                    , directory
                    , filepath
                    , hspec
                    , safe-exceptions
                    , text
                    , unix
