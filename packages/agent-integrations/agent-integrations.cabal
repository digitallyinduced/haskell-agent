cabal-version:      3.0
name:               agent-integrations
version:            0.1.0.0
synopsis:           Typed in-memory integrations for Haskell Agent
description:
    A typed integration registry exposed through an in-memory MCP endpoint.
    Integration account state, authentication, provider transports, and tool
    handlers remain outside the agent orchestration layer.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Network
build-type:         Simple

common common-options
    default-language: GHC2021
    default-extensions:
        BlockArguments
        DuplicateRecordFields
        GADTs
        LambdaCase
        NamedFieldPuns
        NoFieldSelectors
        NumericUnderscores
        OverloadedRecordDot
        OverloadedStrings
        RecordWildCards
        ScopedTypeVariables
        TypeApplications
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wpartial-fields
        -Werror=incomplete-patterns

library
    import:          common-options
    hs-source-dirs:  src
    exposed-modules:
        Agent.Integrations
        Agent.Integrations.Admin
        Agent.Integrations.Registry
        Agent.Integrations.Runtime
        Agent.Integrations.Server
        Agent.Integrations.Types
        Agent.Integrations.Email.Gateway
        Agent.Integrations.Email.Imap
        Agent.Integrations.Email.Mime
        Agent.Integrations.Email.Module
        Agent.Integrations.Email.OAuth
        Agent.Integrations.Email.Store
        Agent.Integrations.Email.Tools
        Agent.Integrations.Email.Transport
    build-depends:
        agent-cli-runtime >= 0.1 && < 0.2
        , agent-core >= 0.1 && < 0.2
        , agent-json >= 0.1 && < 0.2
        , agent-mail >= 0.1 && < 0.2
        , agent-mcp >= 0.1 && < 0.2
        , aeson >= 2.0 && < 3
        , async >= 2.2 && < 2.3
        , base >= 4.17 && < 5
        , base64-bytestring >= 1.2 && < 1.3
        , bytestring >= 0.11 && < 0.13
        , containers >= 0.6 && < 0.8
        , crypton >= 1.0 && < 1.2
        , directory >= 1.3 && < 1.4
        , entropy >= 0.4 && < 0.5
        , filepath >= 1.5 && < 1.6
        , http-client >= 0.7 && < 0.8
        , http-client-tls >= 0.3 && < 0.5
        , http-types >= 0.12 && < 0.13
        , memory >= 0.18 && < 0.19
        , network >= 3.2 && < 3.3
        , safe-exceptions >= 0.1.7 && < 0.2
        , text >= 2.0 && < 2.2
        , temporary >= 1.3 && < 1.4
        , time >= 1.12 && < 1.15
        , unix >= 2.8 && < 2.9

test-suite agent-integrations-test
    import:          common-options
    type:            exitcode-stdio-1.0
    hs-source-dirs:  test
    main-is:         Spec.hs
    other-modules:
        Agent.Integrations.AdminSpec
        Agent.Integrations.RuntimeSpec
        Agent.Integrations.Email.GatewaySpec
        Agent.Integrations.Email.MimeSpec
        Agent.Integrations.Email.OAuthSpec
        Agent.Integrations.Email.StoreSpec
        Agent.Integrations.ServerSpec
        Agent.Integrations.Email.ToolsSpec
        Agent.Integrations.Email.TransportSpec
    build-depends:
        agent-integrations
        , agent-json
        , agent-mcp
        , agent-core
        , agent-mail
        , aeson
        , async
        , base
        , base64-bytestring
        , bytestring
        , directory
        , filepath
        , hspec >= 2.11 && < 2.12
        , http-types
        , network
        , network-uri
        , safe-exceptions
        , text
        , temporary
        , time
        , unix
