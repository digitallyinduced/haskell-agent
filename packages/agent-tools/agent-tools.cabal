cabal-version:      2.2
name:               agent-tools
version:            0.1.0.0
synopsis:           Concrete local tools for the agent harness
description:        Filesystem, shell, GHCi, code-mode, planning, artifact,
                    image, chart, and subagent tool implementations.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple
extra-source-files: README.md
                  , benchmark/ArtifactRetrieval.md
                  , benchmark/ArtifactStorage.md
                  , cbits/javascriptcore-worker.mm
                  , data/code-mode/javascriptcore/*.js
data-files:         data/code-mode/worker.mjs

common common-opts
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
                      , PackageImports
    ghc-options:      -Wall
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wno-unused-do-bind
                      -Wno-name-shadowing
                      -Wno-missing-signatures

library
    import:           common-opts
    exposed-modules:  Agent.Tools.Background
                    , Agent.Tools.CodeMode
                    , Agent.Tools.CodeMode.Client
                    , Agent.Tools.CodeMode.Host
                    , Agent.Tools.CodeMode.Protocol
                    , Agent.Tools.CodeMode.Tool
                    , Agent.Tools.Dangerous
                    , Agent.Tools.FileSystem
                    , Agent.Tools.FileSystem.GitIgnore
                    , Agent.Tools.FileSystem.Grep
                    , Agent.Tools.FileSystem.ListDir
                    , Agent.Tools.FileSystem.ReadFile
                    , Agent.Tools.Ghci
                    , Agent.Tools.Ghci.Classify
                    , Agent.Tools.Ghci.Runtime
                    , Agent.Tools.Ghci.Tool
                    , Agent.Tools.IO
                    , Agent.Tools.MultiAgents
                    , Agent.Tools.OutputArtifact
                    , Agent.Tools.OutputArtifact.Retrieval
                    , Agent.Tools.PlanMode
                    , Agent.Tools.TaskPlan
                    , Agent.Tools.Secret
                    , Agent.Tools.ShowImage
                    , Agent.Tools.ShellReadOnly
                    , Agent.Tools.ShellPermission
                    , Agent.Tools.ViewImage
                    , Agent.Tools.RenderChart
    other-modules:    Agent.Tools.CodeMode.Host.Types
                    , Agent.Tools.CodeMode.Host.Availability
                    , Agent.Tools.CodeMode.Host.Worker
                    , Paths_agent_tools
    autogen-modules:  Paths_agent_tools
    hs-source-dirs:   src
    build-depends:    base >= 4.14 && < 5
                    , extra
                    , agent-core >= 0.1 && < 0.2
                    , agent-json >= 0.1 && < 0.2
                    , agent-process >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , async >= 2.2.6 && < 2.3
                    , base64-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , JuicyPixels
                    , process
                    , safe-exceptions
                    , scientific
                    , stm
                    , template-haskell
                    , text
                    , time
                    , transformers
                    , unix
                    , vector

benchmark grep-streaming-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          GrepStreaming.hs
    ghc-options:      -O2 -rtsopts
    build-depends:    agent-tools
                    , async
                    , base >= 4.14 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , process
                    , safe-exceptions
                    , time
                    , unix

benchmark output-artifact-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          OutputArtifact.hs
    ghc-options:      -O2 -rtsopts
    build-depends:    agent-core
                    , agent-tools
                    , base >= 4.14 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , safe-exceptions
                    , text

benchmark artifact-storage-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          ArtifactStorage.hs
    ghc-options:      -O2 -rtsopts
    build-depends:    agent-core
                    , agent-tools
                    , base >= 4.14 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , safe-exceptions
                    , text

benchmark read-file-streaming-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          ReadFileStreaming.hs
    ghc-options:      -O2 -rtsopts
    build-depends:    agent-core
                    , agent-tools
                    , base >= 4.14 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , text
                    , unix

benchmark code-mode-pool-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          CodeModePool.hs
    ghc-options:      -O2
    build-depends:    agent-tools
                    , base >= 4.14 && < 5
                    , safe-exceptions
                    , text
                    , time

benchmark artifact-retrieval-bench
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark src
    main-is:          ArtifactRetrieval.hs
    other-modules:    Agent.Tools.OutputArtifact.Retrieval
    ghc-options:      -O2 -rtsopts
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , bytestring
                    , directory
                    , text

test-suite agent-tools-test
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.Tools.CodeMode.HostSpec
                    , Agent.ToolDispatchSpec
                    , Agent.Tools.CodeMode.ProtocolSpec
                    , Agent.Tools.DangerousSpec
                    , Agent.Tools.FileSystem.GrepSpec
                    , Agent.Tools.FileSystem.ListDirSpec
                    , Agent.Tools.FileSystem.ReadFileSpec
                    , Agent.Tools.GhciSpec
                    , Agent.Tools.IOSpec
                    , Agent.Tools.LoopIntegrationSpec
                    , Agent.Tools.MultiAgentsSpec
                    , Agent.Tools.OutputArtifactSpec
                    , Agent.Tools.OutputArtifactMemorySpec
                    , Agent.Tools.OutputArtifact.RetrievalSpec
                    , Agent.Tools.PlanModeSpec
                    , Agent.Tools.TaskPlanSpec
                    , Agent.Tools.SecretSpec
                    , Agent.Tools.ShowImageSpec
                    , Agent.Tools.ViewImageSpec
                    , Agent.Tools.RenderChartSpec
    build-depends:    base >= 4.14 && < 5
                    , agent-core
                    , agent-tools
                    , agent-json
                    , agent-responses-types
                    , aeson
                    , async
                    , base64-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , hspec
                    , JuicyPixels
                    , process
                    , QuickCheck >= 2.14 && < 2.16
                    , safe-exceptions
                    , stm
                    , text
                    , time
                    , unix
