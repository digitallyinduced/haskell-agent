cabal-version:      3.0
name:               agent-telegram
version:            0.1.0.0
synopsis:           Telegram gateway for the universal agent harness
description:        Dedicated Telegram bot gateway backed by persisted agent
                    sessions.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wincomplete-record-updates
                      -Wpartial-fields
                      -Wno-name-shadowing

library
    import:           common-options
    hs-source-dirs:   src
    other-modules:    Agent.Telegram.Classify
    exposed-modules:  Agent.Telegram
                    , Agent.Telegram.Bridge
                    , Agent.Telegram.Client
                    , Agent.Telegram.Log
                    , Agent.Telegram.Markdown
                    , Agent.Telegram.Types
                    , Agent.Telegram.Voice
    build-depends:    agent-cli >= 0.1 && < 0.2
                    , agent-core >= 0.1 && < 0.2
                    , agent-store >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , async
                    , base >= 4.17 && < 5
                    , bytestring
                    , containers
                    , directory
                    , filelock
                    , filepath
                    , http-client
                    , http-client-tls
                    , http-types
                    , process >= 1.6.26
                    , retry >= 0.9.3.1 && < 0.10
                    , safe-exceptions
                    , text >= 2.0 && < 2.2
                    , time
                    , unix
                    , vector

executable agent-telegram
    import:           common-options
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4 -M8G"
    build-depends:    agent-telegram
                    , base >= 4.17 && < 5

test-suite agent-telegram-test
    import:           common-options
    type:             exitcode-stdio-1.0
    ghc-options:      -threaded
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.TelegramSpec
    build-depends:    agent-core
                    , agent-telegram
                    , aeson
                    , base >= 4.17 && < 5
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , hspec >= 2.11 && < 2.12
                    , safe-exceptions
                    , temporary
                    , text

benchmark media-downloads-bench
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          MediaDownloads.hs
    ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-T"
    build-depends:    agent-telegram
                    , base >= 4.17 && < 5
                    , filepath
                    , text
                    , temporary
                    , time
