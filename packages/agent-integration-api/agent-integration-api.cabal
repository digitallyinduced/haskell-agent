cabal-version: 3.0
name: agent-integration-api
version: 0.1.0.0
synopsis: Provider-neutral integration embedding API
description: Generic process ownership and MCP seams for integration providers.
license: MIT
license-file: LICENSE
author: digitally induced GmbH
maintainer: marc@digitallyinduced.com
build-type: Simple

common options
    default-language: GHC2021
    default-extensions: BlockArguments, LambdaCase, OverloadedStrings,
                        OverloadedRecordDot, RecordWildCards
    ghc-options: -Wall -Werror=incomplete-patterns

library
    import: options
    hs-source-dirs: src
    exposed-modules: Agent.Integration.API
    build-depends: base >= 4.17 && < 5, agent-core, agent-json, agent-mcp,
                   aeson, text

test-suite agent-integration-api-test
    import: options
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Spec.hs
    build-depends: base >= 4.17 && < 5, agent-integration-api, agent-core,
                   agent-mcp, async, filepath, hspec >= 2.11 && < 2.12,
                   safe-exceptions, temporary
