cabal-version:      3.0
name:               agent-computer-use
version:            0.1.0.0
synopsis:           Frontend-independent desktop capture and computer-use tools
description:        Desktop backend interfaces, accessibility observations,
                    guarded input and local screenshot capture for the harness.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           System
build-type:         Simple
extra-source-files: README.md

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall -Wcompat -Werror=incomplete-patterns
                      -Werror=missing-fields -Wno-name-shadowing
    build-depends:    agent-core >= 0.1 && < 0.2
                    , agent-json >= 0.1 && < 0.2
                    , agent-responses-types >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , async
                    , base >= 4.17 && < 5
                    , base64-bytestring
                    , bytestring
                    , containers
                    , dbus >= 1.4 && < 1.5
                    , directory
                    , entropy
                    , filepath
                    , JuicyPixels
                    , process >= 1.6.26
                    , safe-exceptions
                    , stm
                    , text >= 2.0 && < 2.2
                    , unix
                    , vector

-- Shared source inventory lets white-box tests exercise platform internals
-- without exposing them to application consumers.
common computer-use-modules
    other-modules:    Agent.ComputerUse.Input
                    , Agent.ComputerUse.Linux
                    , Agent.ComputerUse.Linux.Logind
                    , Agent.ComputerUse.Linux.Portal
                    , Agent.ComputerUse.Linux.X11

library
    import:           common-options, computer-use-modules
    hs-source-dirs:   src
    exposed-modules:  Agent.ComputerUse
                    , Agent.ComputerUse.Backend
                    , Agent.ComputerUse.Accessibility
                    , Agent.ComputerUse.Semantic
                    , Agent.ComputerUse.Transport

test-suite agent-computer-use-test
    import:           common-options, computer-use-modules
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test, src
    main-is:          Spec.hs
    ghc-options:      -threaded
    other-modules:    Agent.ComputerUseSpec
                    , Agent.ComputerUse.SemanticSpec
                    , Agent.ComputerUse.TransportSpec
                    , Agent.ComputerUse.Transport
                    , Agent.ComputerUse.Semantic
                    , Agent.ComputerUse
                    , Agent.ComputerUse.Backend
                    , Agent.ComputerUse.Accessibility
    build-depends:    hspec >= 2.11 && < 2.12

benchmark accessibility-delta-bench
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          AccessibilityDelta.hs
    ghc-options:      -O2 -rtsopts "-with-rtsopts=-T"
    build-depends:    agent-computer-use

benchmark portal-capture-bench
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark, src
    main-is:          PortalCapture.hs
    other-modules:    Agent.ComputerUse.Backend
                    , Agent.ComputerUse.Input
                    , Agent.ComputerUse.Linux.Logind
                    , Agent.ComputerUse.Linux.Portal
    ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-T"
