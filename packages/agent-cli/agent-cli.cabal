cabal-version:      3.0
name:               agent-cli
version:            0.1.0.0
synopsis:           Command-line interface for the universal agent harness
description:        Command-line interface for a model-independent coding and
                    digital-work agent harness.
license:            BSD-3-Clause
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wpartial-fields
                      -Wno-name-shadowing

library
    import:           common-options
    hs-source-dirs:   src
    exposed-modules:  Agent.CLI
                    , Agent.CLI.AgentSessions
                    , Agent.CLI.AgentViewport
                    , Agent.CLI.Approval
                    , Agent.CLI.Artifact
                    , Agent.CLI.Auth
                    , Agent.CLI.Btw
                    , Agent.CLI.CancelWatch
                    , Agent.CLI.Clipboard
                    , Agent.CLI.Compaction
                    , Agent.CLI.Command
                    , Agent.CLI.CredentialStore
                    , Agent.CLI.ImagePreview
                    , Agent.CLI.Input
                    , Agent.CLI.Interrupt
                    , Agent.CLI.Login
                    , Agent.CLI.Markdown
                    , Agent.CLI.ModelPicker
                    , Agent.CLI.Models
                    , Agent.CLI.Notification
                    , Agent.CLI.Options
                    , Agent.CLI.Permission
                    , Agent.CLI.PendingInputs
                    , Agent.CLI.Picker
                    , Agent.CLI.Plan
                    , Agent.CLI.Progress
                    , Agent.CLI.Project
                    , Agent.CLI.Prompt
                    , Agent.CLI.Request
                    , Agent.CLI.ProviderFallback
                    , Agent.CLI.ProviderTransition
                    , Agent.CLI.Render
                    , Agent.CLI.ReplMode
                    , Agent.CLI.Resume
                    , Agent.CLI.Session
                    , Agent.CLI.SessionEnv
                    , Agent.CLI.SessionTitle
                    , Agent.CLI.Skills
                    , Agent.CLI.Status
                    , Agent.CLI.SubagentStore
                    , Agent.CLI.Subagents.Runtime
                    , Agent.CLI.Style
                    , Agent.CLI.Terminal
                    , Agent.CLI.Timestamp
                    , Agent.CLI.Tools
                    , Agent.CLI.TUI.App
                    , Agent.CLI.TUI.Bridge
                    , Agent.CLI.TUI.ImagePreview
                    , Agent.CLI.TUI.Markdown
                    , Agent.CLI.TUI.Theme
                    , Agent.CLI.UI.Model
                    , Agent.CLI.Turn
                    , Agent.CLI.Usage
                    , Agent.CLI.Worktree
    build-depends:    agent-core >= 0.1 && < 0.2
                    , agent-openai >= 0.1 && < 0.2
                    , agent-openrouter >= 0.1 && < 0.2
                    , agent-responses >= 0.1 && < 0.2
                    , agent-xai >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , ansi-terminal >= 1.0
                    , async
                    , base >= 4.17 && < 5
                    , base64-bytestring
                    , brick >= 2.9 && < 3
                    , bytestring
                    , colour >= 2.3
                    , containers
                    , directory
                    , filepath
                    , haskeline >= 0.8 && < 0.9
                    , JuicyPixels
                    , mtl
                    , process >= 1.6.26
                    , safe-exceptions
                    , stm
                    , text >= 2.0 && < 2.2
                    , time
                    , transformers
                    , unix
                    , vty >= 6.4 && < 7
                    , vty-crossplatform >= 0.4 && < 0.5

executable agent-cli
    import:           common-options
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M8G -A64m"
    build-depends:    agent-cli
                    , base >= 4.17 && < 5

test-suite agent-cli-test
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.CLI.ApprovalSpec
                    , Agent.CLI.AgentSessionsSpec
                    , Agent.CLI.ArtifactSpec
                    , Agent.CLI.AgentViewportSpec
                    , Agent.CLI.AuthSpec
                    , Agent.CLI.BtwSpec
                    , Agent.CLI.CancelWatchSpec
                    , Agent.CLI.ClipboardSpec
                    , Agent.CLI.CommandSpec
                    , Agent.CLI.CompactionSpec
                    , Agent.CLI.CredentialStoreSpec
                    , Agent.CLI.ImagePreviewSpec
                    , Agent.CLI.InputSpec
                    , Agent.CLI.InterruptSpec
                    , Agent.CLI.LoginSpec
                    , Agent.CLI.MarkdownSpec
                    , Agent.CLI.ModelPickerSpec
                    , Agent.CLI.ModelsSpec
                    , Agent.CLI.NotificationSpec
                    , Agent.CLI.OptionsSpec
                    , Agent.CLI.PlanSpec
                    , Agent.CLI.ProjectSpec
                    , Agent.CLI.PermissionSpec
                    , Agent.CLI.PickerSpec
                    , Agent.CLI.PendingInputsSpec
                    , Agent.CLI.ProgressSpec
                    , Agent.CLI.PromptSpec
                    , Agent.CLI.ProviderFallbackSpec
                    , Agent.CLI.ProviderTransitionSpec
                    , Agent.CLI.RequestSpec
                    , Agent.CLI.RenderSpec
                    , Agent.CLI.ReplStatusSpec
                    , Agent.CLI.ResumeSpec
                    , Agent.CLI.StyleSpec
                    , Agent.CLI.TimestampSpec
                    , Agent.CLI.TerminalSpec
                    , Agent.CLI.SessionSpec
                    , Agent.CLI.SessionTitleSpec
                    , Agent.CLI.SkillsSpec
                    , Agent.CLI.SubagentStoreSpec
                    , Agent.CLI.ToolsSpec
                    , Agent.CLI.TUIBridgeSpec
                    , Agent.CLI.TUIImagePreviewSpec
                    , Agent.CLI.TUIMarkdownSpec
                    , Agent.CLI.UIModelSpec
                    , Agent.CLI.UsageSpec
                    , Agent.CLI.WorktreeSpec
    build-depends:    agent-cli
                    , agent-core
                    , agent-openai
                    , agent-responses
                    , aeson
                    , ansi-terminal
                    , base >= 4.17 && < 5
                    , bytestring
                    , colour
                    , containers
                    , directory
                    , filepath
                    , haskeline >= 0.8 && < 0.9
                    , hspec >= 2.11 && < 2.12
                    , JuicyPixels
                    , process
                    , safe-exceptions
                    , text
                    , time
                    , unix
