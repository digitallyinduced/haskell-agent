cabal-version:      3.0
name:               agent-cli
version:            0.1.0.0
synopsis:           Command-line interface for the universal agent harness
description:        Command-line interface for a model-independent coding and
                    digital-work agent harness.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple
data-files:         data/CHANGELOG.md
                  , skills/add-model/SKILL.md
                  , skills/learn-about-user/SKILL.md
                  , skills/post-task-learning-review/SKILL.md
                  , skills/resume-claude/SKILL.md
                  , skills/resume-codex/SKILL.md
                  , skills/resume-cursor/SKILL.md
                  , skills/resume-grok/SKILL.md
                  , skills/shared/resume-session/CORE.md
                  , skills/skill-installer/SKILL.md
                  , skills/telegram-agent/SKILL.md
                  , skills/wait-for-ci/SKILL.md

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wincomplete-record-updates
                      -Wpartial-fields
                      -Wno-name-shadowing

