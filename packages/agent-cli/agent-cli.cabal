cabal-version:      3.0
name:               agent-cli
version:            0.1.0.0
synopsis:           Command-line interface for the universal agent harness
description:        Command-line interface for a model-independent coding and
                    digital-work agent harness.
license:            BSD-3-Clause
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wpartial-fields
                      -Wno-name-shadowing

library
    import:           common-options
    hs-source-dirs:   src
    exposed-modules:  Agent.CLI
                    , Agent.CLI.Auth
                    , Agent.CLI.Command
                    , Agent.CLI.Markdown
                    , Agent.CLI.Options
                    , Agent.CLI.Prompt
                    , Agent.CLI.Render
                    , Agent.CLI.Tools
                    , Agent.CLI.Worktree
    build-depends:    agent-core >= 0.1 && < 0.2
                    , agent-openai >= 0.1 && < 0.2
                    , agent-openrouter >= 0.1 && < 0.2
                    , agent-xai >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , ansi-terminal >= 1.0
                    , base >= 4.17 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , process
                    , text >= 2.0 && < 2.2
                    , time

executable agent-cli
    import:           common-options
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:    agent-cli
                    , base >= 4.17 && < 5

test-suite agent-cli-test
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.CLI.AuthSpec
                    , Agent.CLI.CommandSpec
                    , Agent.CLI.MarkdownSpec
                    , Agent.CLI.OptionsSpec
                    , Agent.CLI.PromptSpec
                    , Agent.CLI.RenderSpec
                    , Agent.CLI.ToolsSpec
                    , Agent.CLI.WorktreeSpec
    build-depends:    agent-cli
                    , agent-core
                    , agent-openai
                    , aeson
                    , ansi-terminal
                    , base >= 4.17 && < 5
                    , bytestring
                    , directory
                    , filepath
                    , hspec >= 2.11 && < 2.12
                    , process
                    , text
                    , time
                    , unix
