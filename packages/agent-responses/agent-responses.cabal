cabal-version:      2.2
name:               agent-responses
version:            0.1.0.0
synopsis:           Provider-neutral Responses codecs and adapters
description:        Responses API codecs, stream merging, and loop adapters
                    built on the canonical agent-responses-types data model.
license:            BSD-3-Clause
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Web
build-type:         Simple
extra-source-files: README.md
                  , benchmark/README.md

common common-opts
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , DeriveGeneric
                      , RecordWildCards
                      , NamedFieldPuns
                      , NumericUnderscores
                      , TypeApplications
                      , ScopedTypeVariables
                      , DerivingStrategies
                      , GeneralizedNewtypeDeriving
                      , DataKinds
                      , FlexibleContexts
                      , TupleSections
                      , PackageImports
    ghc-options:      -Wall
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wno-unused-do-bind
                      -Wno-name-shadowing
                      -Wno-missing-signatures

library
    import:           common-opts
    exposed-modules:  Agent.Responses.Codec
                    , Agent.Responses.Client
                    , Agent.Responses.Error
                    , Agent.Responses.GenericBackend
                    , Agent.Responses.GenericClient
                    , Agent.Responses.HttpSSE
                    , Agent.Responses.Hermes
                    , Agent.Responses.Request
                    , Agent.Responses.SSE
                    , Agent.Responses.ResponseMerge
                    , Agent.Responses.StreamAssembly
                    , Agent.Responses.LoopBackend
    hs-source-dirs:   src
    build-depends:    base                  >= 4.14 && < 5
                    , agent-core            >= 0.1 && < 0.2
                    , agent-json-codec      == 0.1.0.0
                    , agent-json-hermes     == 0.1.0.0
                    , agent-responses-types >= 0.1 && < 0.2
                    , base64-bytestring
                    , bytestring
                    , containers
                    , http-client
                    , http-client-tls
                    , http-conduit
                    , hermes-json
                    , retry
                    , safe-exceptions
                    , scientific
                    , text
                    , vector

test-suite agent-responses-test
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.Responses.ClientSpec
                    , Agent.Responses.LoopBackendSpec
                    , Agent.Responses.GenericClientSpec
                    , Agent.Responses.ResponseMergeSpec
                    , Agent.Responses.SSESpec
                    , Agent.Responses.StreamAssemblySpec
    build-depends:    base >= 4.14 && < 5
                    , agent-core
                    , agent-json-codec
                    , agent-responses
                    , agent-responses-types
                    , aeson >= 2.0
                    , bytestring
                    , containers
                    , hspec
                    , QuickCheck >= 2.14 && < 2.16
                    , retry
                    , text

benchmark responses-hot-path
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   benchmark
    main-is:          ResponsesHotPath.hs
    ghc-options:      -O2 -rtsopts
    build-depends:    agent-core
                    , agent-json-codec
                    , agent-json-hermes
                    , agent-responses
                    , agent-responses-types
                    , aeson >= 2.2 && < 2.4
                    , base >= 4.14 && < 5
                    , bytestring
                    , text
