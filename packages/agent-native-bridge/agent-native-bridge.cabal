cabal-version:      3.0
name:               agent-native-bridge
version:            0.1.0.0
synopsis:           Native host integration for the agent harness
description:        Host-administration helpers and the macOS native shared
                    bridge used by the desktop application.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           System
build-type:         Simple
extra-source-files: include/HaskellAgentBridge.h

common common-options
    default-language: GHC2021
    default-extensions: BlockArguments
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
    ghc-options:      -Wall
                      -Wcompat
                      -Widentities
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wincomplete-record-updates
                      -Wpartial-fields
                      -Wno-name-shadowing

library
    import:           common-options
    hs-source-dirs:   src
    exposed-modules:  Agent.CLI.BrowserTools
                    , Agent.CLI.McpAdmin
                    , Agent.CLI.McpConnection
                    , Agent.CLI.ResourceAdmin
    build-depends:    agent-cli >= 0.1 && < 0.2
                    , agent-core >= 0.1 && < 0.2
                    , agent-json >= 0.1 && < 0.2
                    , agent-mcp >= 0.1 && < 0.2
                    , agent-store >= 0.1 && < 0.2
                    , base >= 4.17 && < 5
                    , bytestring
                    , containers
                    , filepath
                    , network-uri
                    , http-client
                    , http-client-tls
                    , safe-exceptions
                    , text >= 2.0 && < 2.2
                    , time
                    , transformers
                    , uuid

foreign-library haskell-agent-bridge
    import:           common-options
    if !os(darwin)
        buildable:    False
    type:             native-shared
    options:          standalone
    hs-source-dirs:   ffi
    other-modules:    Agent.CLI.MacOS.Bridge
                   , Agent.CLI.MacOS.BundledIntegrations
                   , Agent.CLI.MacOS.AgentSnapshot
                   , Agent.CLI.MacOS.EngineCallbacks
                   , Agent.CLI.MacOS.EngineEvents
                   , Agent.CLI.MacOS.EngineHandle
                   , Agent.CLI.MacOS.EngineHostRegistration
                   , Agent.CLI.MacOS.EngineLifecycle
                   , Agent.CLI.MacOS.EngineStaging
                   , Agent.CLI.MacOS.EngineState
                   , Agent.CLI.MacOS.EngineStore
                   , Agent.CLI.MacOS.EngineSubmission
                   , Agent.CLI.MacOS.ConnectionBridge
                   , Agent.CLI.MacOS.InteractionState
                   , Agent.CLI.MacOS.NativeInteraction
                   , Agent.CLI.MacOS.NativeRequestHandler
                   , Agent.CLI.MacOS.NativeSessionCommands
                   , Agent.CLI.MacOS.NativeSupervisor
                   , Agent.CLI.MacOS.TurnEvents
                   , Agent.CLI.MacOS.TurnExecution
                   , Agent.CLI.MacOS.TurnInputs
                   , Agent.CLI.MacOS.TurnState
                    , Agent.CLI.MacOS.AccountConnection
                    , Agent.CLI.MacOS.AccountBridge
                    , Agent.CLI.MacOS.BrowserBridge
                    , Agent.CLI.MacOS.GatewayBridge
                    , Agent.CLI.MacOS.Marshalling
                    , Agent.CLI.MacOS.ComputerBridge
                    , Agent.CLI.MacOS.EngineMailbox
                    , Agent.CLI.MacOS.NativeLoopEvent
                    , Agent.CLI.MacOS.RepositoryWorkers
                    , Agent.CLI.MacOS.RepositoryChecks
                    , Agent.CLI.MacOS.RepositoryDeliveryBridge
                    , Agent.CLI.MacOS.RepositoryReviewBridge
                    , Agent.CLI.MacOS.NativeRequest
                    , Agent.CLI.MacOS.NativeGatewayBoundary
                    , Agent.CLI.MacOS.NativeModelCatalog
                    , Agent.CLI.MacOS.McpAdminBridge
                    , Agent.CLI.MacOS.McpConnectionBridge
                    , Agent.CLI.MacOS.McpConnectionOperation
                    , Agent.CLI.MacOS.McpKeychain
                    , Agent.CLI.MacOS.McpCredentialStore
                    , Agent.CLI.MacOS.DatabaseBrowseBridge
                    , Agent.CLI.MacOS.LearnedSkillsBridge
                    , Agent.CLI.MacOS.RepositoryInput
                    , Agent.CLI.MacOS.ResourceAdmin
                    , Agent.CLI.MacOS.SessionTransferBridge
                    , Agent.CLI.MacOS.SessionObservationBridge
    c-sources:        cbits/HaskellAgentBridgeRuntime.c
                    , cbits/HaskellAgentMcpKeychain.c
    frameworks:      Security, CoreFoundation
    include-dirs:     include
    includes:         HaskellAgentBridge.h
    install-includes: HaskellAgentBridge.h
    ghc-options:      -threaded
    build-depends:    agent-native-bridge
                    , agent-repository >= 0.1 && < 0.2
                    , agent-cli >= 0.1 && < 0.2
                    , agent-cli-runtime >= 0.1 && < 0.2
                    , agent-integration-api >= 0.1 && < 0.2
                    , agent-json >= 0.1 && < 0.2
                    , agent-runtime-daemon >= 0.1 && < 0.2
                    , agent-core >= 0.1 && < 0.2
                    , agent-responses-types >= 0.1 && < 0.2
                    , agent-store >= 0.1 && < 0.2
                    , agent-openai >= 0.1 && < 0.2
                    , agent-xai >= 0.1 && < 0.2
                    , agent-openrouter >= 0.1 && < 0.2
                    , aeson >= 2.0
                    , async
                    , base >= 4.17 && < 5
                    , base64-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filelock
                    , filepath
                    , JuicyPixels
                    , safe-exceptions
                    , stm
                    , text >= 2.0 && < 2.2
                    , time

test-suite agent-native-bridge-test
    import:           common-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test ffi
    main-is:          Spec.hs
    ghc-options:      -threaded
    other-modules:    Agent.CLI.BrowserToolsSpec
                    , Agent.CLI.MacOS.EngineMailbox
                    , Agent.CLI.MacOS.EngineMailboxSpec
                    , Agent.CLI.MacOS.NativeLoopEvent
                    , Agent.CLI.MacOS.NativeLoopEventSpec
                    , Agent.CLI.MacOS.RepositoryWorkers
                    , Agent.CLI.MacOS.RepositoryWorkersSpec
                    , Agent.CLI.MacOS.RepositoryInput
                    , Agent.CLI.MacOS.RepositoryInputSpec
                    , Agent.CLI.MacOS.TaskSchedulerSpec
                    , Agent.CLI.McpAdminSpec
                    , Agent.CLI.McpConnectionSpec
                    , Agent.CLI.ResourceAdminSpec
    build-depends:    agent-native-bridge
                    , agent-cli
                    , agent-responses-types
                    , agent-integration-api
                    , agent-core
                    , agent-json
                    , agent-mcp
                    , agent-runtime-daemon
                    , agent-store
                    , aeson
                    , async
                    , base >= 4.17 && < 5
                    , base64-bytestring
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , hspec >= 2.11 && < 2.12
                    , safe-exceptions
                    , stm
                    , text
                    , unix
    if os(darwin)
        c-sources:    test/cbits/HaskellAgentBridgeBrowserSmoke.c
                    , test/cbits/HaskellAgentBridgeComputerSmoke.c
                    , test/cbits/HaskellAgentBridgeImageSmoke.c
                    , test/cbits/HaskellAgentBridgeIntegrationSmoke.c
                    , test/cbits/HaskellAgentBridgeTaskSmoke.c
                    , test/cbits/HaskellAgentBridgeSessionObservationSmoke.c
                    , test/cbits/HaskellAgentBridgeMcpConnectionSmoke.c
                    , cbits/HaskellAgentBridgeRuntime.c
                    , cbits/HaskellAgentMcpKeychain.c
        frameworks:   Security, CoreFoundation
        include-dirs: include
        other-modules: Agent.CLI.MacOS.Bridge
                     , Agent.CLI.MacOS.BundledIntegrations
                     , Agent.CLI.MacOS.SessionTransferBridge
                     , Agent.CLI.MacOS.SessionObservationBridge
                     , Agent.CLI.MacOS.SessionObservationBridgeSpec
                     , Agent.CLI.MacOS.AgentSnapshot
                     , Agent.CLI.MacOS.EngineCallbacks
                     , Agent.CLI.MacOS.EngineEvents
                     , Agent.CLI.MacOS.EngineHandle
                     , Agent.CLI.MacOS.EngineHostRegistration
                     , Agent.CLI.MacOS.EngineLifecycle
                     , Agent.CLI.MacOS.EngineStaging
                     , Agent.CLI.MacOS.EngineState
                     , Agent.CLI.MacOS.EngineStore
                     , Agent.CLI.MacOS.EngineSubmission
                     , Agent.CLI.MacOS.ConnectionBridge
                     , Agent.CLI.MacOS.InteractionState
                     , Agent.CLI.MacOS.NativeInteraction
                     , Agent.CLI.MacOS.NativeRequestHandler
                     , Agent.CLI.MacOS.NativeSessionCommands
                     , Agent.CLI.MacOS.NativeSupervisor
                     , Agent.CLI.MacOS.TurnEvents
                     , Agent.CLI.MacOS.TurnExecution
                     , Agent.CLI.MacOS.TurnInputs
                     , Agent.CLI.MacOS.TurnState
                     , Agent.CLI.MacOS.AccountConnection
                     , Agent.CLI.MacOS.AccountConnectionSpec
                     , Agent.CLI.MacOS.AccountBridge
                     , Agent.CLI.MacOS.BrowserBridge
                     , Agent.CLI.MacOS.GatewayBridge
                     , Agent.CLI.MacOS.Marshalling
                     , Agent.CLI.MacOS.ComputerBridge
                     , Agent.CLI.MacOS.RepositoryWorkers
                     , Agent.CLI.MacOS.RepositoryChecks
                     , Agent.CLI.MacOS.RepositoryDeliveryBridge
                     , Agent.CLI.MacOS.RepositoryReviewBridge
                     , Agent.CLI.MacOS.NativeRequest
                     , Agent.CLI.MacOS.NativeGatewayBoundary
                     , Agent.CLI.MacOS.NativeModelCatalog
                     , Agent.CLI.MacOS.McpAdminBridge
                     , Agent.CLI.MacOS.McpConnectionBridge
                     , Agent.CLI.MacOS.McpConnectionOperation
                     , Agent.CLI.MacOS.McpKeychain
                     , Agent.CLI.MacOS.McpCredentialStore
                     , Agent.CLI.MacOS.McpKeychainSpec
                     , Agent.CLI.MacOS.McpConnectionBridgeSpec
                     , Agent.CLI.MacOS.McpConnectionOperationSpec
                     , Agent.CLI.MacOS.DatabaseBrowseBridge
                     , Agent.CLI.MacOS.LearnedSkillsBridge
                    , Agent.CLI.MacOS.ResourceAdmin
                     , Agent.CLI.MacOS.BrowserBridgeFFISpec
                     , Agent.CLI.MacOS.ComputerBridgeSpec
                     , Agent.CLI.MacOS.BridgeSpec
                     , Agent.CLI.MacOS.BridgeHeaderSpec
                     , Agent.CLI.MacOS.BridgeFFISpec
        build-depends: agent-repository
                     , agent-cli-runtime
                     , agent-openai
                     , agent-openrouter
                     , agent-xai
                     , filelock
                     , JuicyPixels
                     , time
