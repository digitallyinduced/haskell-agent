cabal-version: 2.2
name: agent-webrtc
version: 0.1.0.0
synopsis: Scoped WebRTC PCM audio transport
license: MIT
author: digitally induced GmbH
maintainer: marc@digitallyinduced.com
build-type: Simple
extra-source-files: cbits/peer.h cbits/audio.h cbits/helper-protocol.h cbits/helper.c test/peer-smoke.c test/audio-smoke.c test/helper-smoke.c

flag media-helper
    description: Use the bundled media child process for static Linux executables
    default: False
    manual: True

library
    default-language: Haskell2010
    ghc-options: -Wall
    hs-source-dirs: src
    exposed-modules: Agent.WebRTC Agent.WebRTC.Audio
    if flag(media-helper)
        c-sources: cbits/helper-client.c
    else
        c-sources: cbits/peer.c cbits/audio.c
        pkgconfig-depends: gstreamer-webrtc-1.0 >= 1.26
                        , gstreamer-sdp-1.0 >= 1.26
                        , gstreamer-app-1.0 >= 1.26
    include-dirs: cbits
    cc-options: -Wall -Wextra
    build-depends: base >= 4.14 && < 5
                 , bytestring
                 , safe-exceptions
                 , text
