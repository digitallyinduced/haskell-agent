cabal-version:      2.2
name:               agent-core
version:            0.1.0.0
synopsis:           Provider-neutral infrastructure for the agent harness
description:        Shared provider credentials, broker failover, errors,
                    transport utilities, the agent loop, and JSON
                    tool-argument helpers.
license:            BSD-3-Clause
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple
extra-source-files: README.md

common common-opts
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
                      , PackageImports
    ghc-options:      -Wall -Wno-unused-do-bind -Wno-name-shadowing -Wno-missing-signatures

library
    import:           common-opts
    exposed-modules:  Agent.Cancel
                    , Agent.Error
                    , Agent.Provider
                    , Agent.Broker
                    , Agent.Loop
                    , Agent.JsonText
                    , Agent.Http.Url
                    , Agent.ProjectInstructions
                    , Agent.Subagents
                    , Agent.Subagents.Format
                    , Agent.Subagents.Registry
                    , Agent.Subagents.TaskPath
                    , Agent.Subagents.Types
                    , Agent.ToolArgs
                    , Agent.ToolDSL
                    , Agent.ToolDispatch
                    , Agent.Tools
                    , Agent.Tools.ApplyPatch
                    , Agent.Tools.Codex
                    , Agent.Tools.Dangerous
                    , Agent.Tools.FileSystem
                    , Agent.Tools.Grok
                    , Agent.Tools.Grok.Common
                    , Agent.Tools.Grok.Grep
                    , Agent.Tools.Grok.ListDir
                    , Agent.Tools.Grok.Prompt
                    , Agent.Tools.Grok.ReadFile
                    , Agent.Tools.Grok.SearchReplace
                    , Agent.Tools.Grok.Shell
                    , Agent.Tools.Grok.Task
                    , Agent.Tools.Grok.TaskControl
                    , Agent.Tools.Grok.Terminal
                    , Agent.Tools.Ghci
                    , Agent.Tools.Ghci.Classify
                    , Agent.Tools.IO
                    , Agent.Tools.MultiAgents
                    , Agent.Tools.PlanMode
                    , Agent.Tools.Types
                    , Agent.Transport.WebSocket
    hs-source-dirs:   src
    build-depends:    base >= 4.14 && < 5
                    , aeson >= 2.0
                    , async
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , http-conduit
                    , process
                    , safe-exceptions
                    , stm
                    , text
                    , time
                    , unix
                    , vector
                    , websockets

test-suite agent-core-test
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.CancelSpec
                    , Agent.ErrorSpec
                    , Agent.LoopSpec
                    , Agent.JsonTextSpec
                    , Agent.ProjectInstructionsSpec
                    , Agent.SubagentsSpec
                    , Agent.Subagents.TaskPathSpec
                    , Agent.ToolArgsSpec
                    , Agent.ToolDispatchSpec
                    , Agent.Tools.CodexSpec
                    , Agent.Tools.DangerousSpec
                    , Agent.Tools.GrokSpec
                    , Agent.Tools.Grok.TaskSpec
                    , Agent.Tools.GhciSpec
                    , Agent.Tools.IOSpec
                    , Agent.Tools.PlanModeSpec
                    , Agent.ToolDSLSpec
                    , Agent.Transport.WebSocketSpec
    build-depends:    base >= 4.14 && < 5
                    , agent-core
                    , aeson
                    , async
                    , directory
                    , filepath
                    , containers
                    , hspec
                    , safe-exceptions
                    , stm
                    , text
                    , time
                    , bytestring
                    , unix
                    , websockets
