cabal-version:      2.2
name:               agent-core
version:            0.1.0.0
synopsis:           Provider-neutral infrastructure for the agent harness
description:        Shared provider credentials, errors,
                    transport utilities, the agent loop, and JSON
                    tool-argument helpers.
license:            BSD-3-Clause
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Development
build-type:         Simple
extra-source-files: README.md
data-files:         src/Agent/Responses/Types.hs

common common-opts
    default-language: Haskell2010
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , RecordWildCards
                      , NamedFieldPuns
                      , TypeApplications
                      , ScopedTypeVariables
                      , PackageImports
                      , DerivingStrategies
                      , FlexibleContexts
    ghc-options:      -Wall
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wno-unused-do-bind
                      -Wno-name-shadowing
                      -Wno-missing-signatures

library
    import:           common-opts
    autogen-modules:  Paths_agent_core
    other-modules:    Paths_agent_core
    exposed-modules:  Agent.Auth.JWT
                    , Agent.Cancel
                    , Agent.Error
                    , Agent.FileRetry
                    , Agent.InterAgentMessage
                    , Agent.Provider
                    , Agent.Provider.Options
                    , Agent.Responses.Types
                    , Agent.Loop
                    , Agent.JsonText
                    , Agent.OsPath
                    , Agent.Http.Header
                    , Agent.Http.Url
                    , Agent.ProjectInstructions
                    , Agent.ResourceScope
                    , Agent.Retry
                    , Agent.Skills
                    , Agent.Subagents
                    , Agent.Subagents.Format
                    , Agent.Subagents.Registry
                    , Agent.Subagents.TaskPath
                    , Agent.Subagents.Types
                    , Agent.ToolArgs
                    , Agent.ToolDSL
                    , Agent.ToolDispatch
                    , Agent.Tools
                    , Agent.Tools.ApplyPatch
                    , Agent.Tools.Codex
                    , Agent.Tools.Dangerous
                    , Agent.Tools.FileSystem
                    , Agent.Tools.Grok
                    , Agent.Tools.Grok.Common
                    , Agent.Tools.Grok.Grep
                    , Agent.Tools.Grok.ListDir
                    , Agent.Tools.Grok.Prompt
                    , Agent.Tools.Grok.ReadFile
                    , Agent.Tools.Grok.SearchReplace
                    , Agent.Tools.Grok.Shell
                    , Agent.Tools.Grok.Task
                    , Agent.Tools.Grok.TaskControl
                    , Agent.Tools.Grok.Terminal
                    , Agent.Tools.Ghci
                    , Agent.Tools.Ghci.Classify
                    , Agent.Tools.Ghci.Runtime
                    , Agent.Tools.Ghci.Tool
                    , Agent.Tools.HaskellProgram
                    , Agent.Tools.IO
                    , Agent.Tools.MultiAgents
                    , Agent.Tools.PlanMode
                    , Agent.Tools.Types
                    , Agent.Transport.WebSocket
    hs-source-dirs:   src
    build-depends:    base >= 4.14 && < 5
                    , aeson >= 2.0
                    , async
                    , base64-bytestring
                    , bytestring
                    , containers
                    , crypton-connection
                    , directory
                    , filepath
                    , process
                    , retry >= 0.9.3.1 && < 0.10
                    , resourcet
                    , safe-exceptions
                    , scientific
                    , stm
                    , text
                    , time
                    , tls
                    , transformers
                    , unix
                    , vector
                    , websockets
                    , yaml

test-suite agent-core-test
    import:           common-opts
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Agent.Auth.JWTSpec
                    , Agent.CancelSpec
                    , Agent.ErrorSpec
                    , Agent.Http.HeaderSpec
                    , Agent.LoopSpec
                    , Agent.OsPathSpec
                    , Agent.JsonTextSpec
                    , Agent.ProjectInstructionsSpec
                    , Agent.Provider.OptionsSpec
                    , Agent.ResourceScopeSpec
                    , Agent.RetrySpec
                    , Agent.SkillsSpec
                    , Agent.SubagentsSpec
                    , Agent.Subagents.TaskPathSpec
                    , Agent.ToolArgsSpec
                    , Agent.ToolDispatchSpec
                    , Agent.Tools.CodexSpec
                    , Agent.Tools.DangerousSpec
                    , Agent.Tools.GrokSpec
                    , Agent.Tools.Grok.TaskSpec
                    , Agent.Tools.GhciSpec
                    , Agent.Tools.HaskellProgramSpec
                    , Agent.Tools.IOSpec
                    , Agent.Tools.MultiAgentsSpec
                    , Agent.Tools.PlanModeSpec
                    , Agent.ToolDSLSpec
                    , Agent.Transport.WebSocketSpec
    build-depends:    base >= 4.14 && < 5
                    , agent-core
                    , aeson
                    , async
                    , base64-bytestring
                    , directory
                    , filepath
                    , containers
                    , hspec
                    , retry >= 0.9.3.1 && < 0.10
                    , safe-exceptions
                    , stm
                    , text
                    , time
                    , tls
                    , bytestring
                    , crypton-connection
                    , unix
                    , websockets
                    , yaml
