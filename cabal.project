packages:
    packages/agent-process
    packages/agent-mail
    packages/agent-cli-runtime
    packages/agent-cli
    packages/agent-telegram
    packages/agent-core
    packages/agent-mcp
    packages/agent-codex-dialect
    packages/agent-grok-build-dialect
    packages/agent-json
    packages/agent-syntax
    packages/agent-tui
    packages/agent-responses-types
    packages/agent-responses
    packages/agent-openai
    packages/agent-xai
    packages/agent-openrouter
    packages/agent-gemini
    packages/agent-store
    packages/claude-agent-sdk-haskell
    packages/agent-claude
    packages/agent-runtime-daemon

tests: True
multi-repl: True

-- Keep local Cabal builds on the same Hasql API set as the Nix package set.
constraints:
    hasql == 2.0.1.0,
    hasql-pool == 1.5.0.1,
    hasql-transaction == 1.2.3.1

source-repository-package
    type: git
    location: https://github.com/velveteer/hermes.git
    tag: c04619a2b490fb49c67cacc0d2eb15368b78505f
